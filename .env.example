# Optional shell environment. Defaults work without this file.
# npm scripts do not load .env automatically. Export variables in your shell.
PAYMENT_MODE=agung
PORT=3334
PEAQ_RPC_URL=https://peaq-agung.api.onfinality.io/public
EB_DATA_DIR=data/local
# Wallet keys are generated in the ignored data directory. Do not put keys here.

