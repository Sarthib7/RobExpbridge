# ExperienceBridge v0.1 — copy to .env for local overrides.
# Do not commit real private keys, mnemonics, or API secrets.

PORT=8787
DATA_DIR=./data

# peaq settlement mode: "simulated" (default) or "live"
# Live mode requires PEAQ_RPC_URL, PEAQ_SEED (test-only), and PEAQ_ENABLED=true.
PEAQ_MODE=simulated
PEAQ_ENABLED=false
# PEAQ_RPC_URL=
# PEAQ_SEED=
