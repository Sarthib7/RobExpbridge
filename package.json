{
  "name": "experiencebridge",
  "version": "0.1.0",
  "description": "Evidence-backed robot experience exchange — v0.1 deterministic simulator MVP",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
