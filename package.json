{
  "name": "experiencebridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "start": "node --import tsx src/server.ts",
    "check": "tsc --noEmit",
    "dev:local": "node --import tsx scripts/local.ts",
    "demo:payments": "node --import tsx scripts/payment-demo.ts",
    "start:agung": "node --import tsx src/server.ts",
    "testnet:check": "node --import tsx scripts/check-testnet.ts",
    "start:solana": "PAYMENT_MODE=solana-devnet node --import tsx src/server.ts",
    "batch:devnet": "node --import tsx scripts/batch-runs.ts",
    "peaqos:check": "node --import tsx scripts/peaqos-check.ts",
    "build:public": "node --import tsx scripts/build-public.ts",
    "demo:batches": "node --import tsx scripts/simulation-batches.ts",
    "peaqos:activate": "node --import tsx scripts/peaqos-check.ts --activate"
  },
  "dependencies": {
    "@peaqos/peaq-os-sdk": "^0.11.2",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.4.0",
    "ethers": "^6.17.0",
    "fastify": "^5.6.0",
    "viem": "^2.57.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
